# Copia questo file in .env e compila i valori.

# --- API-Football --------------------------------------------------------
# Chiave da https://dashboard.api-football.com (registrazione diretta)
# oppure da RapidAPI, cambiando anche il provider qui sotto.
API_FOOTBALL_KEY=

# 'apisports' per la registrazione diretta, 'rapidapi' per il proxy RapidAPI.
API_FOOTBALL_PROVIDER=apisports

# Limite giornaliero del tuo piano. Il piano gratuito e' 100.
# Il client rifiuta le richieste oltre questa soglia: e' l'unica difesa contro
# il restare senza dati proprio quando escono le formazioni ufficiali.
DAILY_REQUEST_LIMIT=100

# Secondi minimi fra due richieste spedite davvero (le risposte dalla cache
# non aspettano). Difende dal limite AL MINUTO, che e' cosa diversa da quello
# giornaliero: sul piano gratuito sono 10 richieste al minuto, e superarlo fa
# rispondere 429 all'API mentre la richiesta viene contata lo stesso — si paga
# e non si riceve il dato. 7 secondi tengono il ritmo a 8 al minuto.
# Su un piano a pagamento abbassalo (0.25 tiene ~240 al minuto), altrimenti un
# riempimento storico impiega ore invece che minuti.
API_MIN_INTERVAL_SECONDS=7

# --- Notifiche su Telegram (facoltative) ---------------------------------
# Senza queste due righe il sistema funziona identico e in silenzio: una
# notifica e' un di piu', mai un requisito.
#
# Il token lo da' @BotFather su Telegram creando un bot (/newbot).
# La chat: scrivi un messaggio al tuo bot, poi apri
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# e copia il numero in "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Manda anche il rumore di fondo: utile i primi giorni per vedere che la
# macchina gira, dannoso se lasciato acceso. Novanta messaggi al giorno che
# dicono "non e' il momento" insegnano a ignorare anche gli allarmi.
TELEGRAM_VERBOSO=0

# --- Dati ----------------------------------------------------------------
# Serie A. La struttura non e' vincolata a un singolo campionato.
LEAGUE_ID=135

# Stagioni su cui stimare il modello. Ognuna costa UNA richiesta.
# Attenzione: il piano gratuito di API-Football copre solo alcune stagioni;
# se una non e' inclusa, la risposta arriva vuota.
# Le stagioni ricomprate con un piano a pagamento NON vanno elencate qui:
# vivono in data/storico/<anno>/ e il dataset le trova da solo
# (vedi scripts/riempi_storico.py).
SEASONS=2022,2023,2024

# --- Database (opzionale finche' si lavora sulla sola cache) --------------
# Stringa di connessione Postgres di Supabase:
# postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Percorsi (di norma non serve toccarli) ------------------------------
# CACHE_DIR=data/cache
# BUDGET_FILE=data/budget.json
# STORICO_DIR=data/storico
# IMPORTATO_DIR=data/importato
